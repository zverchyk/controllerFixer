# Required: Resend API key used to deliver repair requests
RESEND_API_KEY=

# Optional: overrides the default recipient (techoleks@gmail.com)
REPAIR_REQUEST_EMAIL=

# Optional: a verified Resend sender; defaults to onboarding@resend.dev
REPAIR_FROM_EMAIL=

# Optional spam protection; verification is skipped when these are unset
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
