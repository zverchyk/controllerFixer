# Public Cloudflare Turnstile site key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-side Cloudflare Turnstile secret
TURNSTILE_SECRET_KEY=

# Resend API key and destination inbox
RESEND_API_KEY=
REPAIR_REQUEST_EMAIL=repairs@example.com

# A verified Resend sender (optional while testing with onboarding@resend.dev)
REPAIR_FROM_EMAIL="StickLab <repairs@example.com>"
